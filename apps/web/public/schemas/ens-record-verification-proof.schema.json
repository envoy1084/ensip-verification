{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ens.domains/schemas/ens-record-verification-proof.schema.json",
  "title": "ENS Record Verification Proof Envelope",
  "type": "object",
  "required": ["v", "claim", "authoritySignature", "methodProof"],
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": "ensrv1"
    },
    "claim": {
      "type": "object",
      "required": [
        "name",
        "node",
        "recordType",
        "recordKey",
        "valueHash",
        "authorityVersion",
        "method",
        "target",
        "issuedAt",
        "validUntil"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "node": {
          "$ref": "#/$defs/bytes32"
        },
        "recordType": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "recordKey": {
          "type": "string",
          "maxLength": 255
        },
        "valueHash": {
          "$ref": "#/$defs/bytes32"
        },
        "authorityVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,9})$"
        },
        "method": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
        },
        "target": {
          "type": "string",
          "maxLength": 1024
        },
        "issuedAt": {
          "$ref": "#/$defs/uint64"
        },
        "validUntil": {
          "$ref": "#/$defs/uint64"
        }
      }
    },
    "authoritySignature": {
      "$ref": "#/$defs/bytes"
    },
    "methodProof": {
      "type": "object"
    }
  },
  "$defs": {
    "bytes32": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "bytes": {
      "type": "string",
      "pattern": "^0x([0-9a-f]{2})+$"
    },
    "uint64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    }
  }
}
