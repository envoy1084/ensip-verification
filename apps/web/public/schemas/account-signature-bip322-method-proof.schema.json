{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ens.domains/schemas/account-signature-bip322-method-proof.schema.json",
  "title": "BIP-322 Account Signature Method Proof",
  "type": "object",
  "required": ["format", "signature"],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "bip322-simple-v2"
    },
    "signature": {
      "type": "string",
      "pattern": "^smp(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    }
  }
}
