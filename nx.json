{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default"],
    "sharedGlobals": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/tsconfig.json",
      "{workspaceRoot}/oxfmt.config.ts",
      "{workspaceRoot}/oxlint.config.ts",
      "{workspaceRoot}/internal/oxc/package.json",
      "{workspaceRoot}/internal/oxc/src/**/*.ts",
      "{workspaceRoot}/internal/tsconfig/package.json",
      "{workspaceRoot}/internal/tsconfig/src/**/*.json",
      "{workspaceRoot}/internal/tsdown/package.json",
      "{workspaceRoot}/internal/tsdown/src/**/*.ts"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production", "sharedGlobals"]
    },
    "typecheck": {
      "cache": true,
      "inputs": ["production", "^production", "sharedGlobals"],
      "outputs": []
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "sharedGlobals"],
      "outputs": []
    },
    "lint:fix": {
      "cache": false,
      "inputs": ["default", "sharedGlobals"],
      "outputs": []
    },
    "format:check": {
      "cache": true,
      "inputs": ["default", "sharedGlobals"],
      "outputs": []
    },
    "format": {
      "cache": false,
      "inputs": ["default", "sharedGlobals"],
      "outputs": []
    }
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    }
  ],
  "neverConnectToCloud": true
}
